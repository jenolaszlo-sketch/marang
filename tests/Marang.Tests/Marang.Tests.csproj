    <PackageReference Include="Penghou.Hufu.Sqlite" Version="0.1.0-preview.5" />
    <PackageReference Include="Penghou.Fuwen.Zhinu" Version="0.1.0-preview.13" />
    <PackageReference Include="Penghou.Zhinu" Version="0.2.0-preview.2" />
    <PackageReference Include="Penghou.Zhinu.Sqlite" Version="0.2.0-preview.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
